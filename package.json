{
  "name": "masterclip-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MASTERCLIP OS — cinematic AI-video render factory: multi-provider generation, automated QC, cost-per-approved-second accounting, and master-clip delivery.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "scaffold": "node scripts/scaffold.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm -F @masterclip/api dev",
    "dev:worker": "pnpm -F @masterclip/worker dev",
    "dev:web": "pnpm -F @masterclip/web dev",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/lint.mjs",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts",
    "doctor": "tsx apps/cli/src/main.ts doctor",
    "masterclip": "tsx apps/cli/src/main.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "screenshots": "CAPTURE_SCREENSHOTS=1 playwright test screenshots.spec.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@masterclip/agents": "workspace:*",
    "@masterclip/api": "workspace:*",
    "@masterclip/asset-storage": "workspace:*",
    "@masterclip/auth": "workspace:*",
    "@masterclip/cli": "workspace:*",
    "@masterclip/cost-engine": "workspace:*",
    "@masterclip/database": "workspace:*",
    "@masterclip/domain": "workspace:*",
    "@masterclip/media-tools": "workspace:*",
    "@masterclip/model-router": "workspace:*",
    "@masterclip/prompt-compiler": "workspace:*",
    "@masterclip/provider-core": "workspace:*",
    "@masterclip/provider-fal": "workspace:*",
    "@masterclip/provider-google": "workspace:*",
    "@masterclip/provider-luma": "workspace:*",
    "@masterclip/provider-mock": "workspace:*",
    "@masterclip/provider-muapi": "workspace:*",
    "@masterclip/provider-replicate": "workspace:*",
    "@masterclip/provider-runway": "workspace:*",
    "@masterclip/provider-selfhosted": "workspace:*",
    "@masterclip/qc-engine": "workspace:*",
    "@masterclip/queue": "workspace:*",
    "@masterclip/runtime": "workspace:*",
    "@masterclip/shared": "workspace:*",
    "@masterclip/shot-schema": "workspace:*",
    "@masterclip/web": "workspace:*",
    "@masterclip/worker": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  }
}
