# MASTERCLIP OS — configuration
#
# Copy to .env. Never commit .env; `pnpm lint` fails the build if a real key
# appears anywhere in the tree.
#
# Everything below has a working default except the provider credentials. A
# clean checkout runs with no edits at all: SQLite, local file storage, and the
# mock provider, which renders real MP4s with ffmpeg at zero cost.

# ---------------------------------------------------------------- posture ----
# sandbox (default) forbids billable provider calls entirely.
# live permits them, still capped by LIVE_SPEND_CAP_USD.
MASTERCLIP_MODE=sandbox
# Hard ceiling on total real spend across every project. The cost controller
# refuses any submission that would exceed it. Raise deliberately.
LIVE_SPEND_CAP_USD=2

NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4310
WEB_PORT=4311

# Believe X-Forwarded-For? Only when a proxy in front actually overwrites it.
# Left on for a directly exposed port, any client can forge its own source
# address and walk straight through the rate limits below.
TRUST_PROXY=false

# Rate limiting is on by default. RATE_LIMIT_SCALE multiplies every budget --
# raise it for a busy shared deployment rather than turning the limiter off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCALE=1

# Public origin used to build provider webhook callbacks. Leave empty to poll
# instead of receiving callbacks (correct for local development). A managed
# host that publishes its own external URL is picked up automatically, so on
# Render this only needs setting to point at a custom domain.
PUBLIC_BASE_URL=
# Signs our own callback URLs so a provider endpoint cannot be spoofed.
WEBHOOK_SECRET=

# ----------------------------------------------------------- build identity ----
# Reported by /api/health so you can confirm which build is deployed. Hosts
# that inject their own are picked up automatically (Render's
# RENDER_GIT_COMMIT, Vercel's VERCEL_GIT_COMMIT_SHA, Heroku's SOURCE_VERSION);
# set this only to override, or where the host provides nothing.
GIT_COMMIT=

# ---------------------------------------------------------------- live lab ----
# AI audio provider for the Live Lab scene builder. `mock-audio` (default)
# synthesizes real WAVs locally at zero cost with no credentials; a hosted
# music-model adapter registers under its own id and is selected here.
LIVE_AI_PROVIDER=mock-audio

# ----------------------------------------------------------------- song lab ---
# Street Banker Song Lab: analyse a record, compare it against a relevant
# cohort, and hear alternative versions built from the artist's own audio.
#
# SONG_LAB_ENABLED is the umbrella kill switch — off means no Song Lab route or
# job runs at all, whatever an organization is entitled to.
SONG_LAB_ENABLED=true
SONG_LAB_BENCHMARKS_ENABLED=true
SONG_LAB_EXPERIMENTS_ENABLED=true
SONG_LAB_LYRICS_ENABLED=true
# The internal A&R view is Street Banker's own judgement layer. It is
# entitlement-gated per organization as well as flagged here.
SONG_LAB_AR_VIEW_ENABLED=true

# Analysis provider. `local-dsp` (default) runs the in-process DSP engine at
# zero cost and with no credentials; it needs ffmpeg only to decode compressed
# uploads, and falls back per-file to the deterministic provider when ffmpeg is
# unavailable. `mock-song-analysis` forces deterministic placeholders
# everywhere — useful for fast tests, and honest about it: every figure it
# produces is capped at low confidence and labelled as synthesized.
SONG_LAB_ANALYSIS_PROVIDER=local-dsp

# Benchmark data provider. The default ships reference distributions so the
# benchmark flow is operable before a licensed data agreement exists; every
# result it returns is stamped `reference_distribution` in its provenance.
# Replace with a licensed provider id before presenting figures as market data.
SONG_LAB_BENCHMARK_PROVIDER=reference-distribution

# Cap on analysed audio length, so one long upload cannot occupy a worker.
SONG_LAB_MAX_ANALYSIS_SECONDS=900
# Experiment previews are derived and reproducible from the stored edit list,
# so they expire rather than accumulating alongside masters.
SONG_LAB_PREVIEW_RETENTION_DAYS=30

# ------------------------------------------------------------ persistence ----
# sqlite needs nothing installed; postgres needs DATABASE_URL (see docker-compose.yml).
DB_DRIVER=sqlite
SQLITE_PATH=var/masterclip.sqlite
DATABASE_URL=postgres://masterclip:masterclip@127.0.0.1:5432/masterclip

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=var/storage
# Required in production: without it, asset URLs would be forgeable.
ASSET_SIGNING_SECRET=
SESSION_SECRET=
SECRETS_ENCRYPTION_KEY=

# S3-compatible storage (MinIO, R2, S3). Only read when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# -------------------------------------------------------------- providers ----
# MuAPI — aggregator. REST uses x-api-key (the hosted MCP uses Bearer; different scheme).
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai
# Sandbox keys return mock media without consuming credits.
MUAPI_SANDBOX=true

# Google Gemini API (Veo family).
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# fal.ai — Authorization: Key <FAL_KEY>
FAL_KEY=
FAL_BASE_URL=https://queue.fal.run

# Runway — requires the version header; 2024-11-06 confirmed current 2026-08-17.
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06

LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai

REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com

# Self-hosted ComfyUI endpoint. Leave empty unless the benchmark has shown
# self-hosting is cheaper per approved second for your volume.
COMFYUI_BASE_URL=
COMFYUI_API_KEY=

# ------------------------------------------------------- the agent layer -----
# Without a key the pipeline still runs end to end; it just stops making the
# judgement calls (visual QC, creative direction, cost advice) Claude was there for.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_QC_MODEL=claude-haiku-4-5

# -------------------------------------- Street Banker Audio Intelligence ----
# Runs fully on the mock audio provider with no credentials: real WAV files,
# deterministic transcripts, zero spend. Set an ElevenLabs key to go live.
AUDIO_INTELLIGENCE_ENABLED=true
ELEVENLABS_ENABLED=true
MEETING_INTELLIGENCE_ENABLED=true
SIGNAL_AUDIO_BRIEFS_ENABLED=true
AUDIO_OPERATOR_ENABLED=true
GLOBAL_RELEASE_PACK_ENABLED=true
CAMPAIGN_AUDIO_TOOLKIT_ENABLED=true
REMIX_LAB_AUDIO_ENGINE_ENABLED=true
ARTIST_VOICE_VAULT_ENABLED=true
WHITE_LABEL_AUDIO_OPERATOR_ENABLED=true
DUBBING_ENABLED=true
# Generation-heavy, rights-sensitive features are OFF until enabled deliberately.
MUSIC_GENERATION_ENABLED=false
MUSIC_INPAINTING_ENABLED=false
STEM_SEPARATION_ENABLED=true
VOICE_ISOLATION_ENABLED=true
SOUND_EFFECTS_ENABLED=true
VOICE_CLONING_ENABLED=false
# Deployment-wide floor: force every org's policy to require zero retention.
ZERO_RETENTION_REQUIRED=false

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# No default voice on purpose: pick one in your ElevenLabs account and set it here.
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_MUSIC_MODEL=
ELEVENLABS_SFX_MODEL=
# Secret shown when creating the webhook endpoint in the ElevenLabs dashboard.
ELEVENLABS_WEBHOOK_SECRET=
# Attest (true) only if your account tier supports enable_logging=false.
ELEVENLABS_ZERO_RETENTION_CAPABLE=false
# Operator-maintained ESTIMATE rates as JSON; final cost comes from provider
# usage reconciliation. Empty = "no estimate", never a guessed price.
# e.g. {"transcription_per_minute_usd":0.006,"tts_per_1k_chars_usd":0.05}
AUDIO_RATE_CARD=

# ------------------------------------------------------------------ media ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ----------------------------------------------------------------- worker ----
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=120
PROVIDER_POLL_INTERVAL_MS=5000
PROVIDER_JOB_TIMEOUT_MS=1200000
