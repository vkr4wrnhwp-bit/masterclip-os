# MASTERCLIP OS — configuration
#
# Copy to .env. Never commit .env; `pnpm lint` fails the build if a real key
# appears anywhere in the tree.
#
# Everything below has a working default except the provider credentials. A
# clean checkout runs with no edits at all: SQLite, local file storage, and the
# mock provider, which renders real MP4s with ffmpeg at zero cost.

# ---------------------------------------------------------------- posture ----
# sandbox (default) forbids billable provider calls entirely.
# live permits them, still capped (see the two settings below).
MASTERCLIP_MODE=sandbox
# Set CUSTOMER_SPEND_CAP_USD to what each customer may spend per month. This is
# the one setting to manage: the most ONE customer (one account) may spend on
# real renders in one calendar month (UTC), in dollars, as a plain number like 10.
# A customer who reaches it is told so in plain words and cannot render again
# until the 1st. If an account also has a stored monthly budget, the smaller of
# the two applies. Every account in the house organization (the one holding the
# OWNER_EMAILS accounts) is exempt from it and is held only to its stored monthly
# budget ($500 by default) and to LIVE_SPEND_CAP_USD when that is set. Something
# that is not a plain number stops the service at startup; 0 means no live renders.
CUSTOMER_SPEND_CAP_USD=
# LIVE_SPEND_CAP_USD is optional: a monthly emergency brake for the whole service
# (every customer added together, per calendar month, UTC). Leave it unset unless
# you want one; with CUSTOMER_SPEND_CAP_USD set and this blank there is no
# whole-service limit. If NEITHER setting is set, a built-in $2 monthly limit
# applies, so a service never runs with no limit of any kind by accident.
LIVE_SPEND_CAP_USD=

NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4310
WEB_PORT=4311

# Believe X-Forwarded-For? Only when a proxy in front actually overwrites it.
# Left on for a directly exposed port, any client can forge its own source
# address and walk straight through the rate limits below.
TRUST_PROXY=false

# Rate limiting is on by default. RATE_LIMIT_SCALE multiplies every budget --
# raise it for a busy shared deployment rather than turning the limiter off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCALE=1

# Public origin used to build provider webhook callbacks. Leave empty to poll
# instead of receiving callbacks (correct for local development).
PUBLIC_BASE_URL=
# Signs our own callback URLs so a provider endpoint cannot be spoofed.
WEBHOOK_SECRET=

# ------------------------------------------------------------ persistence ----
# sqlite needs nothing installed; postgres needs DATABASE_URL (see docker-compose.yml).
DB_DRIVER=sqlite
SQLITE_PATH=var/masterclip.sqlite
DATABASE_URL=postgres://masterclip:masterclip@127.0.0.1:5432/masterclip

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=var/storage
# Required in production: without it, asset URLs would be forgeable.
ASSET_SIGNING_SECRET=
SESSION_SECRET=
SECRETS_ENCRYPTION_KEY=

# S3-compatible storage (MinIO, R2, S3). Only read when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# -------------------------------------------------------------- providers ----
# MuAPI — aggregator. REST uses x-api-key (the hosted MCP uses Bearer; different scheme).
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai
# Sandbox keys return mock media without consuming credits.
MUAPI_SANDBOX=true

# Google Gemini API (Veo family).
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# fal.ai — Authorization: Key <FAL_KEY>
FAL_KEY=
FAL_BASE_URL=https://queue.fal.run

# Runway — requires the version header; 2024-11-06 confirmed current 2026-08-17.
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06

LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai

REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com

# Self-hosted ComfyUI endpoint. Leave empty unless the benchmark has shown
# self-hosting is cheaper per approved second for your volume.
COMFYUI_BASE_URL=
COMFYUI_API_KEY=

# ------------------------------------------------------- the agent layer -----
# Without a key the pipeline still runs end to end; it just stops making the
# judgement calls (visual QC, creative direction, cost advice) Claude was there for.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_QC_MODEL=claude-haiku-4-5

# ------------------------------------------------------------------ media ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ----------------------------------------------------------------- worker ----
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=120
PROVIDER_POLL_INTERVAL_MS=5000
PROVIDER_JOB_TIMEOUT_MS=1200000
